# Bu dosya şablondur. Gerçek değerler .env dosyasına yazılır (git'e girmez).
# Değerleri Bitwarden'a kaydet: "NESIL1984 / <değişken adı>".

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Veritabanı (Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# PayTR (Faz 6) - önce test anahtarları. Canlı çekim için PAYTR_TEST_MODE=0 yazılmalı.
# PayTR panelinde Bildirim URL: https://<alan-adı>/api/paytr/bildirim
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1

# E-posta (Faz 6, Resend). Boşsa e-postalar gönderilmez, sunucu kaydına yazılır.
RESEND_API_KEY=
EMAIL_FROM=
# Yeni sipariş bildiriminin gideceği mağaza adresi
SHOP_EMAIL=

# Görsel depolama (Faz 3)
CLOUDINARY_URL=

# Admin girişi (Faz 3)
ADMIN_SESSION_SECRET=
